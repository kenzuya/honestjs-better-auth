{
	"name": "@kenzuya/honest-better-auth",
	"version": "1.0.0",
	"description": "Better Auth for HonestJS",
	"author": "Thalles Passos",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenzuya/honestjs-better-auth.git"
	},
	"homepage": "https://github.com/kenzuya/honestjs-better-auth#readme",
	"bugs": {
		"url": "https://github.com/kenzuya/honestjs-better-auth/issues"
	},
	"engines": {
		"node": ">=22.22.1"
	},
	"packageManager": "bun@1.4.2",
	"keywords": [
		"honest",
		"honestjs",
		"hono",
		"better-auth",
		"auth",
		"honest-better-auth"
	],
	"type": "module",
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "unbuild",
		"prepack": "bun run build",
		"lint": "biome lint",
		"format": "biome format",
		"check": "biome check",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:watch": "bun test --watch"
	},
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@faker-js/faker": "^10.0.0",
		"@kenzuya/honest": "^0.1.23",
		"@tsconfig/node22": "^22.0.2",
		"@types/bun": "latest",
		"better-auth": "^1.5.4",
		"hono": "^4.12.8",
		"reflect-metadata": "^0.2.2",
		"typescript": "^5.9.3",
		"unbuild": "^3.6.1"
	},
	"peerDependencies": {
		"@kenzuya/honest": "^0.1.23",
		"better-auth": ">=1.5.0 <2.0.0",
		"hono": "^4.12.8",
		"reflect-metadata": "^0.2.2",
		"typescript": "^5.9.2 || ^6.0.0"
	}
}
